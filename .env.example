# ============================================================
# .env.example — Copy this to mcp-server/.env and fill in values
#
# ALL variables are optional. The app runs without any of them
# using public NOAA + Celestrak + Open Notify data only.
# Credential-gated tools return a clear "not configured" message.
#
# cp .env.example mcp-server/.env
# ============================================================

# ------------------------------------------------------------------
# IBM watsonx.ai — Granite AI briefings per satellite
# Register: https://cloud.ibm.com → create Watson Studio instance
# Without this: AI briefings use a local rule-based template (clearly labelled)
# ------------------------------------------------------------------
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ------------------------------------------------------------------
# Space-Track.org — authoritative GP orbital elements + decay predictions
# Register free: https://www.space-track.org/auth/createAccount
# Without this: get_spacetrack_tle and get_spacetrack_decay return "not configured"
# ------------------------------------------------------------------
SPACETRACK_USER=
SPACETRACK_PASSWORD=
# SPACETRACK_BASE=https://www.space-track.org

# ------------------------------------------------------------------
# N2YO — satellite pass predictions + overhead queries
# Register free: https://www.n2yo.com/api/
# Without this: get_satellite_passes and get_satellites_overhead return "not configured"
# ------------------------------------------------------------------
N2YO_API_KEY=
# N2YO_BASE_URL=https://api.n2yo.com/rest/v1/satellite

# ------------------------------------------------------------------
# Celestrak TLE source (public — no key needed; overrides for testing/caching)
# ------------------------------------------------------------------
# CELESTRAK_GROUP_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP={group}&FORMAT=tle
# CELESTRAK_CATNR_URL=https://celestrak.org/NORAD/elements/gp.php?CATNR={norad_id}&FORMAT=tle
# CELESTRAK_CACHE_TTL_SECONDS=7200

# ------------------------------------------------------------------
# NOAA SWPC space weather (public — no key needed; overrides for testing)
# ------------------------------------------------------------------
# NOAA_KINDEX_URL=https://services.swpc.noaa.gov/json/planetary_k_index_1m.json
# NOAA_SOLAR_WIND_URL=https://services.swpc.noaa.gov/json/rtsw/rtsw_wind_1m.json
# NOAA_XRAY_URL=https://services.swpc.noaa.gov/json/goes/primary/xrays-1-day.json
# NOAA_ALERTS_URL=https://services.swpc.noaa.gov/products/alerts.json

# ------------------------------------------------------------------
# External public APIs (no key needed; overrides for testing)
# ------------------------------------------------------------------
# ISS_NOW_URL=http://api.open-notify.org/iss-now.json
# ISS_ASTROS_URL=http://api.open-notify.org/astros.json
# LAUNCH_LIBRARY_URL=https://ll.thespacedevs.com/2.2.0/launch/upcoming/

# ------------------------------------------------------------------
# Web gateway settings
# ------------------------------------------------------------------
PORT=3000
BROADCAST_GROUP=stations
BROADCAST_LIMIT=8
BROADCAST_INTERVAL_MS=15000
# PYTHON_COMMAND=python3   # auto-detected; override if needed
